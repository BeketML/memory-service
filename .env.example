# ── LLM extraction (required) ────────────────────────────────────────────────
# Provider: openai | anthropic | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# OpenAI (required if LLM_PROVIDER=openai OR DENSE_EMBEDDING=openai)
# This key is used for BOTH extraction AND dense embeddings.
OPENAI_API_KEY=sk-...

# Anthropic (required if LLM_PROVIDER=anthropic)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama (required if LLM_PROVIDER=ollama)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# OLLAMA_HOST=http://host.docker.internal:11434

# ── Embedding models ──────────────────────────────────────────────────────────
# Dense: OpenAI API (no local download; reuses OPENAI_API_KEY)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # default, 1536-d
# DENSE_DIM=1536                                  # must match the model

# Sparse: local BM25 via fastembed (tiny tokenizer, no GPU needed)
# SPARSE_MODEL=Qdrant/bm25

# ColBERT reranker: local via fastembed (~110MB ONNX)
# COLBERT_MODEL=colbert-ir/colbertv2.0
# COLBERT_DIM=128

# ── Optional auth ─────────────────────────────────────────────────────────────
# If set, all requests must carry: Authorization: Bearer <token>
# MEMORY_AUTH_TOKEN=your-secret-token

# ── Stores ────────────────────────────────────────────────────────────────────
# Set automatically in docker-compose.yml; override if needed.
# DATABASE_URL=postgresql://memory:memory@postgres:5432/memory

# If you already have a Qdrant instance running on localhost:6333,
# set QDRANT_URL here and start only postgres+app (skip the qdrant service):
#   docker compose up -d postgres app
# QDRANT_URL=http://host.docker.internal:6333
# QDRANT_COLLECTION=memories
