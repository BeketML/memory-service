# ── LLM extraction (required: pick one provider) ─────────────────────────────
# Provider: openai | anthropic | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Anthropic (required if LLM_PROVIDER=anthropic)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama (required if LLM_PROVIDER=ollama)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# OLLAMA_HOST=http://host.docker.internal:11434

# ── Optional auth ─────────────────────────────────────────────────────────────
# If set, all requests must carry: Authorization: Bearer <token>
# MEMORY_AUTH_TOKEN=your-secret-token

# ── Stores ────────────────────────────────────────────────────────────────────
# DATABASE_URL is set automatically in docker-compose.yml.
# Override if needed:
# DATABASE_URL=postgresql://memory:memory@postgres:5432/memory

# If you already have a Qdrant instance running, point to it here:
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=memories   # collection name to use (default: memories)

# ── Embedding model (default BGE-M3) ──────────────────────────────────────────
# EMBEDDING_MODEL=BAAI/bge-m3
